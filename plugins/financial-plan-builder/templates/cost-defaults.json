{
  "version": "0.1",
  "checked": "2026-10-15",
  "note": "Indicative amounts (EUR excl. VAT) for a small Belgian start-up, used only as a starting point in interview module 7. Every line is shown to the owner, who confirms, changes or declines it; accepted lines are marked as defaults. Lines with \"ask\": true have no usable default and must be asked. Legal amounts are not stored here: \"amount_from\" points into belgian-rules.json.",
  "when": {
    "always": "every plan",
    "premises": "company.premises is 'rented' or 'owned', or (not set and) a business type trade, production or hospitality",
    "rented": "company.premises is 'rented' (or not set and premises apply)",
    "staff": "staff[] is not empty",
    "vehicle": "an investment looks like a vehicle (name), or company.vehicle is true",
    "food": "company.food is true, or business type hospitality",
    "in_kind": "an investment has in_kind: true",
    "type:<t>": "business type <t> is selected",
    "management_only": "the only business type is management (a management or holding company invoicing related companies)",
    "director_paid": "a cost line with category 618 (director remuneration) exists"
  },
  "start_codes": {
    "plan": "first month of the plan",
    "first_staff": "month of the first hire",
    "first_vehicle": "month of the first vehicle investment",
    "fy1_filing": "7 months after the end of the first financial year (filing deadline of the annual accounts)",
    "first_quarter_end": "the first month ending a calendar quarter on or after the start (quarterly social contributions)"
  },
