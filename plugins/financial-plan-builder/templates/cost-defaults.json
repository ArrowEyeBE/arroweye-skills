    {
      "id": "dir_social",
      "when": "director_paid",
      "category": 618,
      "compute": "self_employed",
      "interval_months": 3,
      "start": "first_quarter_end",
      "vat_rate": 0,
      "name": {
        "nl": "Sociale bijdragen zelfstandige bestuurder (betaald door de vennootschap)",
        "fr": "Cotisations sociales de l'administrateur indépendant (payées par la société)",
        "en": "Self-employed director's social contributions (paid by the company)"
      },
      "basis": "Only when the company pays the director's own social contributions (then they are part of the remuneration, category 618); decline when the director pays them out of the gross pay. Estimate per quarter: 20.5% of the yearly director pay, at least the minimum contribution, plus the fund's administration cost (legal_items.self_employed_contributions). A primostarter pays a lower minimum for 4 quarters; a side activity has its own minimum. The social insurance fund's calculation or a pay slip is better."
    },
